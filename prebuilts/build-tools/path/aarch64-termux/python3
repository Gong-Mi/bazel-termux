#!/data/data/com.termux/files/usr/bin/sh
set -eu

# The Python runtime is provided by the official Termux `python` package.
# Keep this AOSP-shaped entry point relocatable across Termux installations.
PYTHON="${TERMUX_PYTHON:-${PREFIX:-/data/data/com.termux/files/usr}/bin/python3}"
exec "$PYTHON" "$@"
